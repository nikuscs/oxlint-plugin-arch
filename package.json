{
  "name": "oxlint-plugin-arch",
  "version": "0.11.0",
  "description": "Configurable architecture rules for Oxlint JavaScript plugins.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset/preset.d.ts",
      "default": "./dist/preset/preset.js"
    },
    "./dillon-anti-slop": {
      "types": "./dist/vendor/dillon-anti-slop/index.d.ts",
      "default": "./dist/vendor/dillon-anti-slop/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "src/vendor/dillon-anti-slop/LICENSE",
    "src/vendor/dillon-anti-slop/UPSTREAM.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/preset/preset.ts src/vendor/dillon-anti-slop/index.ts --root src --outdir dist --target node --format esm --packages external && tsc --project tsconfig.build.json",
    "check": "bun run build && bun run lint && bun run typecheck",
    "lint": "oxlint -c oxlint.self.config.ts --disable-nested-config src",
    "lint:dead": "fallow dead-code",
    "lint:dupes": "fallow dupes",
    "lint:slop": "scanr slop",
    "typecheck": "tsrs --noEmit",
    "prepublishOnly": "bun run check",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh patch --yes",
    "release:minor": "bash scripts/release.sh minor --yes",
    "release:major": "bash scripts/release.sh major --yes"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@oxlint/plugins": "1.89.0",
    "@regru/eslint-plugin-prefer-early-return": "1.0.0",
    "@shadcn/lint": "0.2.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-svg-jsx": "1.3.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-unused-imports": "4.4.1",
    "oxlint-plugin-eslint": "1.89.0",
    "oxlint-tailwindcss": "1.16.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.85.0",
    "oxlint-tsgolint": ">=7.0.2003"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "bumpp": "12.3.0",
    "fallow": "3.36.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikuscs/oxlint-plugin-arch.git"
  },
  "bugs": {
    "url": "https://github.com/nikuscs/oxlint-plugin-arch/issues"
  },
  "homepage": "https://github.com/nikuscs/oxlint-plugin-arch#readme",
  "keywords": [
    "oxlint",
    "eslint",
    "architecture",
    "lint",
    "plugin"
  ],
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
