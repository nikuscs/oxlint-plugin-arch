{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ]
    }
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "scripts/**/*"
  ]
}
